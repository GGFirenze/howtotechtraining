# ---------------------------------------------------------------------------
# CrackVILT — environment variables
# Copy this file to .env.local and fill in values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Everything else stays server-side only.
# ---------------------------------------------------------------------------

# --- Site --------------------------------------------------------------------
# Public, canonical URL of the deployment. Used for OG/canonical tags and
# any place we need to build absolute links (emails, webhooks).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (Milestone 3) --------------------------------------------------
# Project URL and the anon key (safe to expose; RLS denies all by default).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key — server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Lemon Squeezy (Milestone 4) --------------------------------------------
# Webhook signing secret from LS dashboard → Settings → Webhooks → Signing
# secret. Server-only — used by /api/webhook/lemonsqueezy to verify HMAC.
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Public checkout URL of the product (LS dashboard → Products → Share → Buy
# now URL, e.g. https://crackvilt.lemonsqueezy.com/buy/xxxx-xxxx-xxxx).
# When unset, the Pricing CTA renders in its "Checkout opens at launch"
# disabled state — useful before the LS shop is activated.
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=""

# Reserved for future use (subscription, refund automations via the API).
# Not required for the current webhook-driven flow.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""

# Product ID mapping. Server-only (no NEXT_PUBLIC_ prefix — never
# exposed to the browser bundle). Used by the webhook handler to
# resolve each order's product_type ("crackvilt-guide", "strategy-call",
# or "unknown") from the payload's first_order_item.product_id.
#
# Find these numeric IDs in the URL of each LS product page, e.g.
# https://app.lemonsqueezy.com/products/1071611 → 1071611.
#
# When unset the webhook falls back gracefully: unmapped orders are
# treated as "crackvilt-guide" (backward compat with all orders made
# before this feature) unless the Guide ID is set, in which case
# unmapped orders are tagged "unknown" for later cleanup.
LEMONSQUEEZY_GUIDE_PRODUCT_ID=""
LEMONSQUEEZY_STRATEGY_CALL_PRODUCT_ID=""

# --- Resend (Milestone 5) ----------------------------------------------------
RESEND_API_KEY=""
# Verified sender, e.g. "Giuliano <[email protected]>"
RESEND_FROM=""

# --- Services / consulting intake -------------------------------------------
# Public Cal.com link used for the "intro call" CTAs on the two higher
# service tiers (VILT Delivery Pack £2,500 and Train the Trainer
# £3,000). Both tiers require a 15-minute scoping call before we agree
# the engagement — direct checkout would create refund risk since the
# scope is negotiated. Format: "https://cal.com/<handle>/<event-slug>".
# When unset, the CTA falls back to a mailto: info@crackvilt.com link.
NEXT_PUBLIC_CAL_URL=""

# Lemon Squeezy "Buy now" URL for the £120 Strategy Call product. This
# was used briefly when the site offered a paid Strategy Call directly.
# As of August 2026, every service tier routes to a free exploratory
# Cal.com call instead, so this URL is no longer consumed by the UI. It
# is kept documented in case the paid Strategy Call is reintroduced.
NEXT_PUBLIC_STRATEGY_CALL_CHECKOUT_URL=""

# --- Amplitude (Milestone 8) -------------------------------------------------
# Project API key from Amplitude (Settings → Projects → API Keys → "API
# key"). Single key per project — used by both the browser SDK (client
# bundle) and the Node SDK (server-side webhook events). Safe to expose.
NEXT_PUBLIC_AMPLITUDE_API_KEY=""

# --- Google Ads (Milestone 8) -----------------------------------------------
# Account-level conversion ID from Google Ads (Tools → Conversions → click
# any action → Tag setup → "AW-XXXXXXXXX"). Single ID per account, used
# by the global gtag.js loader to capture GCLID and send page-level
# engagement signals back to Google Ads. Loaded only after the user
# accepts the cookie banner. Safe to expose (it is publicly visible in
# the page source whenever the script loads).
#
# When unset, GoogleAdsInit logs a single dev warning and skips loading
# the tag — the rest of the app keeps working.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=""

# --- Rate limiting (Milestone 10) -------------------------------------------
# Upstash Redis (REST endpoint), used for rate limiting checkout & download.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Error monitoring (Milestone 10) ----------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
